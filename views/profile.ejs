<%- include('partials/header', { title: 'Profile', user: user }) %>

<section class="container">
  <div class="profile-layout">
    <aside class="profile-panel profile-summary">
      <% if (user.profilePicture && user.profilePicture.url) { %>
      <img src="<%= user.profilePicture.url %>" class="profile-avatar" alt="<%= user.username %>'s profile picture" data-fallback="<%= user.username.charAt(0).toUpperCase() %>" />
      <% } else { %>
      <div class="profile-avatar" role="img" aria-label="<%= user.username %>'s profile avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <% } %>
      <h1><%= user.username %></h1>
      <p class="profile-email"><%= user.email %></p>
      <% if (user.bio) { %>
      <p class="profile-bio"><%= user.bio %></p>
      <% } %>
      <div class="profile-facts">
        <div><strong>Joined:</strong> <%= user.createdAt.toDateString() %></div>
        <div><strong>Posts:</strong> <%= postCount %></div>
      </div>
      <a href="/user/edit" class="button button--secondary button--full">Edit profile</a>
      <form action="/user/delete" method="POST" class="spacer-top">
        <button type="submit" class="button button--danger button--full">Delete account</button>
      </form>
    </aside>

    <div class="profile-posts">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Your writing</span>
          <h2>Your posts</h2>
        </div>
        <a href="/posts/add" class="button button--small">Create post</a>
      </div>
      <% if (posts.length > 0) { %>
      <div class="post-grid">
        <% posts.forEach(post => { %>
        <article class="post-card">
          <% if (post.images && post.images.length > 0) { %>
          <img src="<%= post.images[0].url %>" class="post-card__image" alt="<%= post.title %>" loading="lazy" />
          <% } else { %>
          <div class="post-image-placeholder" role="img" aria-label="No post image">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/>
              <circle cx="8.5" cy="9" r="1.5" fill="currentColor"/>
              <path d="m4 17 5-5 3 3 2-2 6 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <% } %>
          <div class="post-card__body">
            <h3 class="post-card__title"><a href="/posts/<%= post._id %>"><%= post.title %></a></h3>
            <div class="post-meta"><time datetime="<%= post.createdAt.toISOString() %>"><%= post.createdAt.toDateString() %></time></div>
            <a href="/posts/<%= post._id %>" class="button button--secondary button--small">Read post <span aria-hidden="true">→</span></a>
          </div>
        </article>
        <% }) %>
      </div>
      <% } else { %>
      <div class="empty-state">
        <h3>No posts yet</h3>
        <p>Your published posts will show up here.</p>
        <a href="/posts/add" class="button">Write your first post</a>
      </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
