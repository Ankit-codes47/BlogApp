<%- include('partials/header', { title, user: user }) %>

<section class="container">
  <span class="eyebrow">The community journal</span>
  <div class="section-heading">
    <div>
      <h1 class="page-heading">Explore posts</h1>
      <p class="page-intro">Ideas, stories, and perspectives shared by the community.</p>
    </div>
    <span class="text-muted"><%= posts.length %> <%= posts.length === 1 ? 'post' : 'posts' %></span>
  </div>

  <% if (posts.length > 0) { %>
  <div class="post-grid">
    <% posts.forEach(post => { %>
    <article class="post-card">
      <% if (post.images && post.images.length > 0) { %>
      <img
        src="<%= post.images[0].url %>"
        class="post-card__image"
        alt="<%= post.title %>"
        loading="lazy"
      />
      <% } else { %>
      <div class="post-image-placeholder" role="img" aria-label="No post image">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/>
          <circle cx="8.5" cy="9" r="1.5" fill="currentColor"/>
          <path d="m4 17 5-5 3 3 2-2 6 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <% } %>
      <div class="post-card__body">
        <h2 class="post-card__title"><a href="/posts/<%= post._id %>"><%= post.title %></a></h2>
        <div class="post-meta">
          <span>By <%= post.author.username %></span>
          <time datetime="<%= post.createdAt.toISOString() %>"><%= post.createdAt.toDateString() %></time>
        </div>
        <% if (post.content) { %>
        <p class="post-card__excerpt"><%= post.content %></p>
        <% } %>
        <a href="/posts/<%= post._id %>" class="button button--secondary button--small">Read post <span aria-hidden="true">→</span></a>
      </div>
    </article>
    <% }) %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <h2>No posts yet</h2>
    <p>When posts are published, they’ll appear here.</p>
    <% if (user) { %>
    <a href="/posts/add" class="button">Create the first post</a>
    <% } %>
  </div>
  <% } %>
</section>

<%- include('partials/footer') %>
