<%- include('partials/header', { title: post ? post.title : title, user: user }) %>

<% if (post) { %>
<article class="container article">
  <% if (error) { %>
  <div class="alert alert--error" role="alert"><%= error %></div>
  <% } %>
  <% if (success) { %>
  <div class="alert alert--success" role="status"><%= success %></div>
  <% } %>
  <header class="article-header">
    <span class="eyebrow">Community story</span>
    <h1 class="article-title"><%= post.title %></h1>
    <div class="post-meta">
      <span>By <%= post.author.username %></span>
      <time datetime="<%= post.createdAt.toISOString() %>"><%= post.createdAt.toDateString() %></time>
    </div>
  </header>

  <div class="article-content"><%= post.content %></div>

  <% if (post.images && post.images.length > 0) { %>
  <div class="article-gallery">
    <% post.images.forEach(image => { %>
    <img src="<%= image.url %>" alt="<%= post.title %>" loading="lazy" />
    <% }) %>
  </div>
  <% } %>

  <% if (
    user &&
    user._id.toString() === post.author._id.toString()
  ) { %>
  <div class="article-actions">
    <a href="/posts/<%= post._id %>/edit" class="button button--secondary">Edit post</a>
    <form action="/posts/<%= post._id %>?_method=DELETE" method="POST">
      <button type="submit" class="button button--danger">Delete post</button>
    </form>
  </div>
  <% } %>
</article>

<section class="comments card" aria-labelledby="comments-heading">
  <h2 id="comments-heading">Conversation</h2>
  <% if (post.comments && post.comments.length > 0) { %>
  <ul class="comment-list">
    <% post.comments.forEach(comment => { %>
    <li class="comment">
      <div>
        <span class="comment-author"><%= comment.author.username %></span>
        <div class="comment-content"><%= comment.content %></div>
      </div>
      <% if (
        user &&
        user._id.toString() === comment.author._id.toString()
      ) { %>
      <div class="comment-actions">
        <a href="/comments/<%= comment._id %>/edit" class="button button--secondary button--small">Edit</a>
        <form action="/comments/<%= comment._id %>?_method=DELETE" method="POST">
          <button type="submit" class="button button--danger button--small">Delete</button>
        </form>
      </div>
      <% } %>
    </li>
    <% }) %>
  </ul>
  <% } else { %>
  <p class="text-muted">No comments yet. Start the conversation.</p>
  <% } %>

  <% if (user) { %>
  <form action="/posts/<%= post._id %>/comments" method="POST" class="comment-form">
    <div class="form-field">
      <label for="comment-content">Add to the conversation</label>
      <textarea class="textarea" name="content" id="comment-content" rows="4" placeholder="Write a thoughtful comment…" required></textarea>
    </div>
    <button type="submit" class="button">Add comment</button>
  </form>
  <% } else { %>
  <p class="form-note">Please <a href="/auth/login">login</a> to add a comment.</p>
  <% } %>
</section>
<% } else { %>
<section class="container container--narrow">
  <div class="empty-state">
    <h1 class="page-heading">Post unavailable</h1>
    <% if (error) { %>
    <p><%= error %></p>
    <% } else { %>
    <p>This post could not be found.</p>
    <% } %>
    <a href="/posts" class="button">Browse posts</a>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
